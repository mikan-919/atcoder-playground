{
  "name": "atcoder-playground",
  "version": "1.0.0",
  "description": "TypeScript workspace for AtCoder",
  "private": true,
  "scripts": {
    "build": "node scripts/atcoder.mjs build",
    "check": "tsc --noEmit && biome-nix lint src scripts template solutions",
    "dev": "node scripts/atcoder.mjs dev",
    "download": "node scripts/atcoder.mjs download",
    "fmt": "biome-nix check --write src scripts template solutions",
    "login": "python3 scripts/login-atcoder.py",
    "new": "node scripts/atcoder.mjs new",
    "run": "node scripts/atcoder.mjs run",
    "submit": "bun run check && node scripts/atcoder.mjs submit",
    "test": "bun run check && node scripts/atcoder.mjs test",
    "watch": "node scripts/atcoder.mjs watch"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.2.21",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.18.1",
    "esbuild": "^0.25.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "data-structure-typed": "^2.1.0"
  }
}
